# RStudio default ignores
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Rendered output — a separate git checkout on the `build` branch, served by
# GitHub Pages. Quarto writes here via `output-dir: _build/docs` in _quarto.yml.
_build

# Quarto build artifacts
/.quarto/
/_freeze/

# Claude Code local config (allow project instructions and skills/)
CLAUDE.local.md
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/skills/

# Cross-machine sync manifests (e.g. Sideways)
.swcopy
.swsymlink

**/*.quarto_ipynb
